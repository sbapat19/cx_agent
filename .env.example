# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=your_gemini_key_here
# Optional. Leave unset: the app asks Google which models your key can call and picks the newest flash model.
# Run backend/scripts/check_gemini.py to see them. To force one: GEMINI_MODEL=<name>
# To try the cheapest model first but still fall back automatically if it fails or runs out of quota:
# GEMINI_PREFERRED=gemini-3.1-flash-lite

# Backend (FastAPI)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Local default is SQLite (./armani_demo.db). For deployment set a Postgres URL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# CORS: exact frontend origin(s), comma separated
# ALLOWED_ORIGIN=http://localhost:5173
